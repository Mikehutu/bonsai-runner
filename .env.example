# Bonsai 27B Runner — Environment Configuration
# Copy to .env and adjust as needed:  cp .env.example .env

# ─── Server ───────────────────────────────────────────
# Port the llama-server will listen on (auto-fallbacks to PORT+1, PORT+2 if busy)
PORT=8080

# Bind address (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
HOST=0.0.0.0

# ─── GPU ──────────────────────────────────────────────
# Number of GPU layers to offload (Metal/CUDA). 99 = all layers.
# Ignored on CPU-only systems.
NGL=99

# ─── Context Size ─────────────────────────────────────
# Maximum context length in tokens. 0 = model default (~32K).
# Tested values:
#   262144  — 262K context (works on CPU + 48 GB DDR5, ~4 GB model + ~1.6 GB KV cache)
#   131072  — 128K context (works on CPU + 32 GB DDR5)
#   65536   — 64K context (works on CPU + 16 GB DDR5)
#   32768   — 32K context (model default, lowest RAM overhead)
#
# KV cache RAM cost: ~6 MB per 1K tokens (Q1_0) or ~8 MB (ternary).
# Total RAM needed ≈ model_size + (context_k * kv_per_1k) + 1 GB overhead.
# Example: 262K context + Q1_0 (3.9 GB) ≈ 3.9 GB + 1.6 GB + 1 GB = ~6.5 GB RAM
CONTEXT_SIZE=0

# ─── Concurrency ──────────────────────────────────────
# Server parallelism (n_parallel). 0 = auto (llama-server default).
# Set to 1 for single-request mode (recommended for benchmarks).
# Set to 4+ for concurrent API serving (each slot gets its own KV cache).
PARALLEL=0

# ─── Offline / Airgapped ─────────────────────────────
# If you have models pre-downloaded and cannot reach HuggingFace:
#
# 1. Download models manually on a machine with internet:
#    pip install huggingface-hub
#    hf download prism-ml/Bonsai-27B-gguf --local-dir ~/.bonsai/models/1bit
#    hf download prism-ml/Ternary-Bonsai-27B-gguf --local-dir ~/.bonsai/models/ternary
#
# 2. Set HF_HUB_OFFLINE=1 in your shell profile:
#    export HF_HUB_OFFLINE=1
#
# 3. The start.sh script will automatically unset HF_HUB_OFFLINE
#    during downloads, so it works whether you're online or offline.
#    If models are already cached, no download is attempted.
#
# HF_HUB_OFFLINE=1

# ─── Model Cache ──────────────────────────────────────
# Where downloaded models are stored. Default: ~/.bonsai/models
# MODELS_DIR=~/.bonsai/models

# ─── llama.cpp Build ──────────────────────────────────
# Where the PrismML llama.cpp fork is cloned and built.
# Default: ~/.bonsai/llama.cpp
# LLAMA_CPP_DIR=~/.bonsai/llama.cpp

# ─── Benchmark Mode ───────────────────────────────────
# When running tool-eval-bench, use:
#   PARALLEL=1 bash start.sh ternary+dspark
# This ensures single-request mode for clean latency measurements.
